{
  "expo": {
    "name": "GYMEZY",
    "slug": "gymezy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/gymezy.jpeg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo/gymezy.png",
      "resizeMode": "contain",
      "backgroundColor": "#003882"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymezy.user"
    },
    "android": {
      "package": "com.gymezy.user",
      "googleServicesFile": "./android/app/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#003882",
        "foregroundImage": "./assets/logo/gymezy.jpeg",
        "backgroundImage": "./assets/android-icon-background.png"
      }
    },
    "web": {
      "favicon": "./assets/logo/gymezy.jpeg"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ]
  }
}
